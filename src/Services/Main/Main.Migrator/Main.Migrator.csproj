<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Infrastructure\Security\Security.Core\Security.Core.csproj"/>
        <ProjectReference Include="..\..\..\Infrastructure\Common\Common.csproj"/>
        <ProjectReference Include="..\..\..\Infrastructure\Security\Security\Security.csproj"/>
        <ProjectReference Include="..\..\Api.Common\Api.Common.csproj"/>
        <ProjectReference Include="..\Main.Persistence\Main.Persistence.csproj"/>
        <ProjectReference Include="..\Modules\Currency\Currency.Persistence\Currency.Persistence.csproj"/>
        <ProjectReference Include="..\Modules\Product\Product.Persistence\Product.Persistence.csproj"/>
        <ProjectReference Include="..\Modules\Identity\Identity.Persistence\Identity.Persistence.csproj"/>
        <ProjectReference Include="..\Modules\Purchase\Purchase.Persistence\Purchase.Persistence.csproj"/>
        <ProjectReference Include="..\Modules\Storage\Storage.Persistence\Storage.Persistence.csproj"/>
        <ProjectReference Include="..\Modules\Pricing\Pricing.Persistence\Pricing.Persistence.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\..\..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
        <Content Include="..\..\..\..\configs\**\*">
            <Link>configs\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

</Project>
