<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <LocanDefaultCulture>en</LocanDefaultCulture>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Core\Domain\Domain.csproj"/>
        <ProjectReference Include="..\..\..\Core\Enums\Enums.csproj"/>
        <ProjectReference Include="..\..\..\Core\Extensions\Extensions.csproj"/>
        <ProjectReference Include="..\..\..\Infrastructure\SchemaGeneration\SchemaGeneration.Abstractions\SchemaGeneration.Abstractions.csproj"/>
        <ProjectReference Include="..\Main.Enums\Main.Enums.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BulkValidation.Core" Version="1.0.9"/>
        <PackageReference Include="BulkValidation.SourceGeneration" Version="1.0.5"/>
        <PackageReference Include="Locan.Generator" Version="1.0.5" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Main.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <LocanResource Include="Localization/**/*.json"
                       GenerateMessages="true"
                       CopyToOutput="false" />
    </ItemGroup>
</Project>
