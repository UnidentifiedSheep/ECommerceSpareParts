<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-Main.Worker-ecb3b657-acdf-477a-96f2-2565685d4040</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9"/>
    </ItemGroup>

    <ItemGroup>
		<Content Include="..\..\..\..\.dockerignore">
		  <Link>.dockerignore</Link>
		</Content>
		<Content Include="..\Main.Api\Templates\Emails\*.cshtml">
			<Link>Templates\Emails\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
        <Content Include="..\..\..\..\configs\**\*">
            <Link>configs\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <LocanResource Include="../Main.Entities/Localization/**/*.json"
                       GenerateMessages="false"
                       CopyToOutput="true"/>

        <LocanResource Include="../../Application.Common/Localization/**/*.json"
                       GenerateMessages="false"
                       CopyToOutput="true"/>

        <LocanResource Include="../../../Core/Domain/Localization/**/*.json"
                       GenerateMessages="false"
                       CopyToOutput="true"/>

        <LocanResource Include="../../../Infrastructure/Mailing/Mailing.Core/Localization/**/*.json"
                       GenerateMessages="false"
                       CopyToOutput="true"/>

        <LocanResource Include="../../../Infrastructure/Security/Localization/**/*.json"
                       GenerateMessages="false"
                       CopyToOutput="true"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Infrastructure\Security\Security.csproj"/>
        <ProjectReference Include="..\..\Api.Common\Api.Common.csproj"/>
        <ProjectReference Include="..\Main.Api\Main.Api.csproj"/>
        <ProjectReference Include="..\Main.Cache\Main.Cache.csproj"/>
        <ProjectReference Include="..\Main.Persistence\Main.Persistence.csproj"/>
    </ItemGroup>
</Project>
