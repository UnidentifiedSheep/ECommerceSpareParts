<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <LocanDefaultCulture>en</LocanDefaultCulture>
        <AssemblyName>Main.Modules.Platform.Abstractions</AssemblyName>
        <RootNamespace>Application.Common</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Locan.Generator" Version="1.0.6"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\..\Core\Domain\Domain.csproj"/>
        <ProjectReference Include="..\..\..\..\Application.Common\Application.Common.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <LocanResource Include="Localization/**/*.json"
                       GenerateMessages="true"
                       CopyToOutput="false"/>
    </ItemGroup>

</Project>
