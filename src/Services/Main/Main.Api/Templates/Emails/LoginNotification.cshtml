@model Mailing.Core.Models.LoginNotificationData;

<!doctype html>
<html lang="@Model.HtmlLang">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.Subject</title>
</head>
<body style="margin:0;padding:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#111827;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"
       style="width:100%;background:#f3f4f6;padding:32px 16px;">
    <tr>
        <td align="center">
            <table role="presentation" width="560" cellpadding="0" cellspacing="0"
                   style="width:100%;max-width:560px;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb;">
                <tr>
                    <td style="padding:32px;">
                        <h1 style="margin:0 0 16px;font-size:24px;line-height:32px;font-weight:700;color:#111827;">
                            @Model.Title
                        </h1>

                        <p style="margin:0 0 24px;font-size:16px;line-height:24px;color:#374151;">
                            @Model.Intro
                        </p>

                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                               style="width:100%;margin:0 0 24px;border-collapse:collapse;">
                            <tr>
                                <td style="padding:10px 12px;border:1px solid #e5e7eb;font-size:14px;color:#6b7280;">
                                    @Model.DateTimeLabel
                                </td>
                                <td style="padding:10px 12px;border:1px solid #e5e7eb;font-size:14px;color:#111827;">
                                    @Model.OccurredAt
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 12px;border:1px solid #e5e7eb;font-size:14px;color:#6b7280;">
                                    @Model.DeviceLabel
                                </td>
                                <td style="padding:10px 12px;border:1px solid #e5e7eb;font-size:14px;color:#111827;">
                                    @Model.Device
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:10px 12px;border:1px solid #e5e7eb;font-size:14px;color:#6b7280;">
                                    @Model.IpAddressLabel
                                </td>
                                <td style="padding:10px 12px;border:1px solid #e5e7eb;font-size:14px;color:#111827;">
                                    @Model.IpAddress
                                </td>
                            </tr>
                        </table>

                        <p style="margin:0;font-size:14px;line-height:20px;color:#374151;">
                            @Model.WasYou
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="padding:20px 32px;background:#fef2f2;border-top:1px solid #fecaca;">
                        <p style="margin:0;font-size:13px;line-height:20px;color:#991b1b;">
                            @Model.NotYou
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
