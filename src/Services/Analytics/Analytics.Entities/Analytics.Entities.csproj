<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LocanDefaultCulture>en</LocanDefaultCulture>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Core\Abstractions\Abstractions.csproj"/>
        <ProjectReference Include="..\..\..\Core\Domain\Domain.csproj"/>
        <ProjectReference Include="..\..\..\Core\Exceptions\Exceptions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BulkValidation.SourceGeneration" Version="1.0.5"/>
        <PackageReference Include="Locan.Generator" Version="1.0.6" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <LocanResource Include="Localization/**/*.json"
                       GenerateMessages="true"
                       CopyToOutput="false"/>
    </ItemGroup>
</Project>
