<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <LocanDefaultCulture>en</LocanDefaultCulture>
        <AssemblyName>Modules.Common</AssemblyName>
        <RootNamespace>Application.Common</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BulkValidation.Core" Version="1.2.0"/>
        <PackageReference Include="FluentValidation" Version="12.1.1"/>
        <PackageReference Include="Locan.Generator" Version="1.0.6"/>
        <PackageReference Include="MediatR" Version="14.1.0"/>
        <PackageReference Include="Scrutor" Version="7.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Application.Common\Application.Common.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <LocanResource Include="Localization/**/*.json"
                       GenerateMessages="true"
                       CopyToOutput="false"/>
    </ItemGroup>

</Project>
